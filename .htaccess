# Fallback for hosts that cannot point the document root at public/:
# keep everything except public/ unreachable, and send requests into public/.
# The rewrite is a no-op when the document root already is public/.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Send plain HTTP to HTTPS. The proxy header covers hosts that terminate TLS in front of Apache;
    # localhost is skipped so Docker development keeps working over HTTP.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    # Never serve application code, SQL or tooling, even though they sit inside the web root.
    RewriteRule ^(src|sql|bin|tests|docs|dist)(/|$) - [F,L]
    # One security.txt for all TheekMind hosts (RFC 9116 allows the redirect).
    RewriteRule ^\.well-known/security\.txt$ https://theekmind.com/.well-known/security.txt [R=301,L]
    RewriteRule ^robots\.txt$ public/robots.php [L]
    RewriteRule ^sitemap\.xml$ public/sitemap.php [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "(^\.(?!well-known$)|\.(sql|md|php-dist|sample\.php|example|pdf)$|^config\.php$|Dockerfile.*|docker-compose.*)">
    Require all denied
</FilesMatch>
